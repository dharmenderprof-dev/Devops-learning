<!DOCTYPE html>
<html>
<head>
    <title>Reviewer Dashboard</title>
</head>
<body>

<h1>Reviewer Dashboard</h1>

<table border="1">

<tr>
<th>ID</th>
<th>Title</th>
<th>Filename</th>
<th>Status</th>
<th>Actions</th>
</tr>

<% submissions.forEach(item => { %>

<tr>
    <td><%= item.id %></td>
    <td><%= item.title %></td>
    <td><%= item.filename %></td>
    <td><%= item.status %></td>
</tr>

<% }) %>

</table>

<br>

<a href="/logout">Logout</a>

</body>
</html>

